<Window x:Class="Magazin.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC ZONE - Storefront" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#0b0f19" MinWidth="1024" MinHeight="768">
    
    <Window.Resources>
        <!-- Generic button style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1e293b"/>
            <Setter Property="AlternatingRowBackground" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0f172a"/>
                        <Setter Property="Foreground" Value="#94a3b8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="#3b82f6"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#1e293b"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3b82f6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Header with Search -->
            <RowDefinition Height="Auto"/> <!-- Categories Horizontal Nav -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- 1. MAIN HEADER (Logo, User Info) -->
        <Border Grid.Row="0" Background="#0b0f19" Padding="25,20" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo -->
                    <ColumnDefinition Width="*"/>    <!-- Empty space -->
                    <ColumnDefinition Width="Auto"/> <!-- User Info -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3b82f6" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="CPU" Foreground="White" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PC ZONE" Foreground="White" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User Account / Cart -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="TxtUsernameConectat" Text="Utilizator" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Right"/>
                        <TextBlock x:Name="TxtRolConectat" Text="(Admin)" Foreground="#3b82f6" FontSize="11" TextAlignment="Right"/>
                    </StackPanel>
                    
                    <Button Content="👤 Contul Meu" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="BtnContulMeu_Click" Style="{StaticResource ActionButton}"/>
                    <Button Content="🛒 Coșul Meu" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Margin="0,0,15,0" Click="BtnCosulMeu_Click" Style="{StaticResource ActionButton}"/>
                    <Button Content="Deconectare" Background="#ef4444" Foreground="White" BorderThickness="0" Padding="15,8" Click="BtnLogout_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. HORIZONTAL NAV BAR (Tabs) -->
        <Border Grid.Row="1" Background="#111827" Padding="35,12" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" x:Name="AdminNavPanel">
                <Button x:Name="BtnTabProduse" Content="PRODUSE" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0" FontSize="13" Padding="15,8" Click="BtnTabProduse_Click" Style="{StaticResource ActionButton}"/>
                <Button x:Name="BtnTabComenzi" Content="COMENZI" Background="Transparent" Foreground="#94a3b8" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0" FontSize="13" Padding="15,8" Click="BtnTabComenzi_Click" Style="{StaticResource ActionButton}"/>
                <Button x:Name="BtnTabUtilizatori" Content="UTILIZATORI" Background="Transparent" Foreground="#94a3b8" FontWeight="Bold" BorderThickness="0" FontSize="13" Padding="15,8" Click="BtnTabUtilizatori_Click" Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>

        <!-- 3. MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1e293b" BorderThickness="0,0,1,0" Padding="0,20,0,0">
                <StackPanel>
                    <!-- Add Product Button (Admin only) -->
                    <StackPanel x:Name="PanelButoaneProduse" Margin="20,0,20,25" Visibility="Visible">
                        <Button Content="+ ADĂUGAȚI PRODUS" Click="BtnAdaugaProdus_Click" Style="{StaticResource ActionButton}" Background="#10b981" Height="40" FontSize="12"/>
                    </StackPanel>

                    <!-- Category List -->
                    <Border Background="#3b82f6" Padding="20,12" Margin="0,0,0,5">
                        <TextBlock Text="FILTRU CATEGORIE" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <ListBox x:Name="ListCategorii" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ListCategorii_SelectionChanged" Margin="10,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1e293b"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1e293b"/>
                                                    <Setter Property="Foreground" Value="#3b82f6"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- RIGHT CONTENT -->
            <Border Grid.Column="1" Background="#0b0f19" Padding="25">
                <Grid>
                    <!-- STOREFRONT (PRODUSE) -->
                    <Grid x:Name="GridMagazinProduse" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Filters / Search -->
                            <RowDefinition Height="*"/>    <!-- ScrollViewer -->
                        </Grid.RowDefinitions>

                        <!-- Filters / Search -->
                        <Border Grid.Row="0" Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <WrapPanel VerticalAlignment="Center">
                                <!-- Criteria -->
                                <StackPanel Margin="0,0,15,5">
                                    <TextBlock Text="Caută după:" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CboCriteriuCautare" Width="120" Height="28" SelectedIndex="0" SelectionChanged="CboCriteriuCautare_SelectionChanged">
                                        <ComboBoxItem Content="General"/>
                                        <ComboBoxItem Content="ID"/>
                                        <ComboBoxItem Content="Nume/Username"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Text Search -->
                                <StackPanel Margin="0,0,15,5">
                                    <TextBlock Text="Text de căutat:" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <Border Background="#0b0f19" CornerRadius="4" Height="28" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtSearch" Grid.Column="0" Background="Transparent" Foreground="White" BorderThickness="0" Padding="5,0" VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtSearch_TextChanged"/>
                                            <Border Grid.Column="1" Background="#3b82f6" CornerRadius="0,3,3,0">
                                                <TextBlock Text="🔍" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                
                                <!-- Sort -->
                                <StackPanel Margin="0,0,15,5">
                                    <TextBlock Text="Sortează după:" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CboSortare" Width="140" Height="28" SelectionChanged="CboSortare_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Nume (A - Z)"/>
                                        <ComboBoxItem Content="Nume (Z - A)"/>
                                        <ComboBoxItem Content="Preț Crescător"/>
                                        <ComboBoxItem Content="Preț Descrescător"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Filtrare Preț -->
                                <StackPanel Margin="0,0,15,5">
                                    <TextBlock Text="Preț (Min - Max):" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtFiltruPretMin" Width="60" Height="28" Background="#0b0f19" Foreground="White" BorderBrush="#334155" TextChanged="TxtSearch_TextChanged"/>
                                        <TextBlock Text="-" Foreground="#64748b" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox x:Name="TxtFiltruPretMax" Width="60" Height="28" Background="#0b0f19" Foreground="White" BorderBrush="#334155" TextChanged="TxtSearch_TextChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Optiuni Extra -->
                                <StackPanel Margin="0,0,15,5" VerticalAlignment="Center">
                                    <TextBlock Text="Opțiuni:" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="ChkFiltruGarantie" Content="Garanție" Foreground="White" Margin="0,0,10,0" Checked="ChkFiltruOptiune_Changed" Unchecked="ChkFiltruOptiune_Changed"/>
                                        <CheckBox x:Name="ChkFiltruDrivere" Content="Drivere" Foreground="White" Margin="0,0,10,0" Checked="ChkFiltruOptiune_Changed" Unchecked="ChkFiltruOptiune_Changed"/>
                                        <CheckBox x:Name="ChkFiltruLivrare" Content="Livrare Rapidă" Foreground="White" Margin="0,0,10,0" Checked="ChkFiltruOptiune_Changed" Unchecked="ChkFiltruOptiune_Changed"/>
                                        <CheckBox x:Name="ChkFiltruReturnare" Content="Retur 14 Zile" Foreground="White" Checked="ChkFiltruOptiune_Changed" Unchecked="ChkFiltruOptiune_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                                
                                <!-- In Stoc -->
                                <StackPanel Margin="0,0,0,5" VerticalAlignment="Center">
                                    <TextBlock Text="Stoc:" FontSize="10" Foreground="#64748b" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <CheckBox x:Name="ChkFiltruStoc" Content="Doar în stoc" Foreground="#10b981" FontWeight="Bold" Checked="ChkFiltruOptiune_Changed" Unchecked="ChkFiltruOptiune_Changed"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" x:Name="ScrollProduse" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ListProduse">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1e293b" CornerRadius="10" Width="240" Margin="0,0,20,20" BorderBrush="#334155" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/> <!-- Placeholder Image -->
                                                        <RowDefinition Height="Auto"/> <!-- Title -->
                                                        <RowDefinition Height="Auto"/> <!-- Rating & Stock -->
                                                        <RowDefinition Height="Auto"/> <!-- Price -->
                                                        <RowDefinition Height="Auto"/> <!-- Button -->
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Info & Admin Actions Overlay -->
                                                    <Grid Panel.ZIndex="10" Margin="8">
                                                        <!-- Info Button -->
                                                        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Content="ℹ️" Width="28" Height="28" Background="#3b82f6" Foreground="White" ToolTip="Detalii Produs" Click="BtnInfoProductCard_Click" Tag="{Binding}" Style="{StaticResource ActionButton}"/>
                                                        
                                                        <!-- Admin Actions -->
                                                        <StackPanel x:Name="AdminCardActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                                            <Button Content="✏️" Width="28" Height="28" Background="#f59e0b" Foreground="White" Margin="0,0,6,0" ToolTip="Editează" Click="BtnEditProductCard_Click" Tag="{Binding}" Style="{StaticResource ActionButton}"/>
                                                            <Button Content="🗑️" Width="28" Height="28" Background="#ef4444" Foreground="White" ToolTip="Șterge" Click="BtnDeleteProductCard_Click" Tag="{Binding}" Style="{StaticResource ActionButton}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Grid.Row="0" Height="150" Background="#0b0f19" CornerRadius="10,10,0,0" Margin="1">
                                                        <TextBlock Text="🖥️" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94a3b8"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="1" Text="{Binding Nume}" Foreground="White" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="15,15,15,8" Height="45" TextTrimming="CharacterEllipsis"/>

                                                    <Grid Grid.Row="2" Margin="15,0,15,8">
                                                        <TextBlock Text="⭐⭐⭐⭐⭐ 4.8" Foreground="#f59e0b" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Stoc, StringFormat='{}{0} IN STOC'}" Foreground="#10b981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <TextBlock Grid.Row="3" Text="{Binding Pret, StringFormat='{}{0:N2} RON'}" Foreground="White" FontWeight="ExtraBold" FontSize="20" Margin="15,5,15,12"/>

                                                    <Button Grid.Row="4" Content="ADAUGA IN COS" Background="#3b82f6" Foreground="White" FontWeight="Bold" Margin="15,0,15,15" Height="38" Style="{StaticResource ActionButton}" Click="BtnAdaugaInCos_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}" Value="Admin">
                                                    <Setter TargetName="AdminCardActions" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state warning -->
                                <StackPanel x:Name="PanelEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                    <TextBlock Text="⚠️" FontSize="42" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nu s-a găsit niciun produs conform criteriilor." FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- COMENZI DATAGRID -->
                    <Grid x:Name="GridComenzi" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📦 Istoric Comenzi Plasate" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Border Grid.Row="1" Background="#111827" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="5" ClipToBounds="True">
                            <DataGrid x:Name="DgdComenzi" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource {x:Type DataGrid}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="Client ID" Binding="{Binding IdClient}" Width="80"/>
                                    <DataGridTextColumn Header="Produse" Binding="{Binding ProduseText}" Width="3*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Dată" Binding="{Binding DataComenzii}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- UTILIZATORI DATAGRID -->
                    <Grid x:Name="GridUtilizatori" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="👥 Gestionare Utilizatori" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel x:Name="PanelButoaneUtilizatori" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Adaugă" Click="BtnAdaugaUtilizator_Click" Style="{StaticResource ActionButton}" Background="#8b5cf6" Margin="0,0,10,0"/>
                                <Button x:Name="BtnEditeazaUtilizator" Content="✏️ Editează" Click="BtnEditeazaUtilizator_Click" Style="{StaticResource ActionButton}" Background="#f59e0b" Margin="0,0,10,0" IsEnabled="False"/>
                                <Button x:Name="BtnStergeUtilizator" Content="🗑️ Șterge" Click="BtnStergeUtilizator_Click" Style="{StaticResource ActionButton}" Background="#ef4444" IsEnabled="False"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Background="#111827" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="5" ClipToBounds="True">
                            <DataGrid x:Name="DgdUtilizatori" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridUtilizatori_SelectionChanged" Style="{StaticResource {x:Type DataGrid}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Nume Complet" Binding="{Binding Nume}" Width="2*"/>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
