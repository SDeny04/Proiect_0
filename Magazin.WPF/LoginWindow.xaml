<Window x:Class="Magazin.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectare Magazin PC" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        SizeToContent="Height"
        Background="#0f172a" WindowStyle="None" AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="4" Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#ef4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="12" Background="#0f172a" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close and Header Section -->
            <Grid Grid.Row="0">
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Click="BtnClose_Click" VerticalAlignment="Top"/>
                
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,15">
                    <!-- CPU Icon from MainWindow logo -->
                    <Border Background="#3b82f6" Width="44" Height="44" CornerRadius="8" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <Grid>
                            <Border BorderBrush="White" BorderThickness="2" Margin="4" CornerRadius="5"/>
                            <TextBlock Text="CPU" Foreground="White" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="PC ZONE" Foreground="White" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Portal de Administrare și Achiziții" Foreground="#64748b" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Main Panel: Toggle Login / Register -->
            <Grid Grid.Row="1" Margin="0,10">
                <!-- 1. LOGIN VIEW -->
                <StackPanel x:Name="PanelLogin" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="Conectare" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Utilizator" Foreground="#94a3b8" Margin="0,0,0,5" FontSize="13"/>
                    <TextBox x:Name="TxtLoginUser" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" KeyDown="LoginInput_KeyDown"/>

                    <TextBlock Text="Parolă" Foreground="#94a3b8" Margin="0,0,0,5" FontSize="13"/>
                    <PasswordBox x:Name="TxtLoginPass" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,20" KeyDown="LoginInput_KeyDown"/>

                    <Button Content="Autentificare" Style="{StaticResource ModernButton}" Click="BtnLogin_Click" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Nu ai cont?" Foreground="#64748b" Margin="0,0,5,0"/>
                        <Button Content="Creează un cont" Style="{StaticResource SecondaryButton}" Click="BtnGoToRegister_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. REGISTER VIEW -->
                <StackPanel x:Name="PanelRegister" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Înregistrare" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Nume Complet" Foreground="#94a3b8" Margin="0,0,0,3" FontSize="12"/>
                    <TextBox x:Name="TxtRegNume" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>

                    <TextBlock Text="Username" Foreground="#94a3b8" Margin="0,0,0,3" FontSize="12"/>
                    <TextBox x:Name="TxtRegUser" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>

                    <TextBlock Text="Email" Foreground="#94a3b8" Margin="0,0,0,3" FontSize="12"/>
                    <TextBox x:Name="TxtRegEmail" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>

                    <TextBlock Text="Parolă" Foreground="#94a3b8" Margin="0,0,0,3" FontSize="12"/>
                    <PasswordBox x:Name="TxtRegPass" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,15"/>

                    <Button Content="Creează Cont Nou" Style="{StaticResource ModernButton}" Click="BtnRegister_Click" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Ai deja cont?" Foreground="#64748b" Margin="0,0,5,0"/>
                        <Button Content="Înapoi la Conectare" Style="{StaticResource SecondaryButton}" Click="BtnGoToLogin_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom Section: Helper Notification (Discretely showing test users) -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="TxtError" Foreground="#ef4444" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
