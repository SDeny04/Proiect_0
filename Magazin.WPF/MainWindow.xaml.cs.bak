        private void BtnLogout_Click(object sender, RoutedEventArgs e)
        {
            var loginWin = new LoginWindow();
            this.Hide();
            if (loginWin.ShowDialog() == true && loginWin.LoggedUser != null)
            {
                var mainWin = new MainWindow(loginWin.LoggedUser);
                mainWin.Show();
                this.Close();
            }
            else
            {
                this.Close();
            }
        }

