        {
            ActualizeazaGrid();
        }

        private void CboCriteriuCautare_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void CboFiltruCategorie_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void DateFiltru_SelectedDateChanged(object sender, SelectionChangedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void TxtFiltruPretMin_TextChanged(object sender, TextChangedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void TxtFiltruPretMax_TextChanged(object sender, TextChangedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void ChkFiltruStoc_Checked(object sender, RoutedEventArgs e)
        {
            ActualizeazaGrid();
        }

        private void ChkFiltruStoc_Unchecked(object sender, RoutedEventArgs e)
        {
