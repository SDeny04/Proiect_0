<Window x:Class="Magazin.WPF.Utils.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmare" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    
    <Border Background="#1e293b" CornerRadius="8" BorderBrush="#3b82f6" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Confirmare Acțiune" Foreground="#f8fafc" FontSize="16" FontWeight="SemiBold" Grid.Row="0" Margin="0,0,0,15"/>
            
            <TextBlock x:Name="TxtMessage" Text="Sunteți sigur că doriți să efectuați această acțiune?" Foreground="#cbd5e1" FontSize="14" Grid.Row="1" TextWrapping="Wrap"/>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Anulează" Width="90" Height="32" Background="Transparent" Foreground="#94a3b8" BorderBrush="#475569" BorderThickness="1" Margin="0,0,10,0" Click="BtnNo_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Confirmă" Width="90" Height="32" Background="#ef4444" Foreground="White" BorderThickness="0" Click="BtnYes_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
